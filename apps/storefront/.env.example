# Browser-facing API base. In production the storefront host proxies /api to the
# API container, so a relative path keeps requests same-origin: no CORS
# preflight, and session cookies do not need SameSite=None.
VITE_API_URL=/api/v1

# How the server-side render reaches the API inside the network. Read at runtime
# by the Node server, never shipped to the browser.
INTERNAL_API_URL=http://127.0.0.1:8000/api/v1

# Shopper sign-in providers. Both are optional and each button is hidden when its
# value is blank, so the page never offers a provider that is not configured.
#
# The Google client id is public by design - it identifies the app to Google and
# is not a secret. The same client also needs the storefront origin registered as
# an authorised JavaScript origin in the Google Cloud console.
VITE_GOOGLE_CLIENT_ID=

# The bot whose Login Widget is embedded. Set by talking to @BotFather. The bot
# token stays on the server: the widget returns a signed payload and the API is
# what verifies it.
VITE_TELEGRAM_BOT_USERNAME=
