VITE_API_URL=http://127.0.0.1:8000/api/v1
# Cloudflare Turnstile site key for bot protection on sign-up / sign-in
# (optional; leave blank to disable the widget).
VITE_TURNSTILE_SITE_KEY=
# Public storefront origin, e.g. https://shops.chmaba.com
# (optional; leave blank until that host exists -- store links then fall back to
# the legacy /order/<token> address, which keeps working either way).
VITE_STOREFRONT_URL=
