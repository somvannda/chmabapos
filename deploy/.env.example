# Copy to deploy/.env and fill in real values. deploy/.env is gitignored and
# is read by deploy/docker-compose.prod.yml (secrets never committed).

# PostgreSQL
POSTGRES_USER=chmaba
POSTGRES_PASSWORD=<strong random password>
POSTGRES_DB=chmabapos

# Auth (long random string, e.g. `openssl rand -hex 32`)
JWT_SECRET=<long random string>
# Lifetime of a single access token. Sign-ins stay alive far longer via the
# rotating refresh cookie (see jwt_remember_ttl_minutes), so keep this short.
JWT_ACCESS_TTL_MINUTES=15

# Domains / CORS
FRONTEND_URL=https://chmaba.com
CORS_ORIGINS=https://chmaba.com,https://admin.chmaba.com,https://www.chmaba.com,https://shops.chmaba.com

# Google OAuth (optional; leave blank until configured in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://chmaba.com/api/v1/auth/google/callback

# Cloudflare Turnstile bot protection on register/login (optional). When the
# secret is blank the check is skipped. The same site key goes to the web build
# as VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# Public Turnstile site key baked into the web bundle at image build time (same
# value as TURNSTILE_SITE_KEY above). Blank disables the widget.
VITE_TURNSTILE_SITE_KEY=

# Public storefront host. Leave blank until it is actually serving over HTTPS.
#   VITE_STOREFRONT_URL - switches the web app's store links to the branded address
#     and shows the header "Stores" link. Baked into the WEB BUNDLE AT BUILD TIME,
#     so changing it requires a rebuild (up -d --build), not a restart.
#   STOREFRONT_URL - read by the API at runtime, so it can put a "follow your
#     order" link into customer email.
VITE_STOREFRONT_URL=
STOREFRONT_URL=

# Shopper sign-in on the storefront (optional; each button hides when blank).
# The Google client id is PUBLIC by design and must also be listed as an
# authorised JavaScript origin for the storefront host in the Google Cloud
# console. The Telegram username comes from @BotFather, which must additionally
# have the storefront domain set via /setdomain; the bot TOKEN stays server-side
# (TELEGRAM_BOT_TOKEN above), because the API is what verifies the signature.
VITE_GOOGLE_CLIENT_ID=
VITE_TELEGRAM_BOT_USERNAME=

# ChmabaPay (https://pay.chmaba.com). There is no sandbox: CHAMABAPAY_MODE=mock
# is a local fake. Set PAYMENTS_PROVIDER=chamabapay to activate.
CHAMABAPAY_MODE=mock
CHAMABAPAY_API_URL=https://pay.chmaba.com/api
CHAMABAPAY_API_KEY=
CHAMABAPAY_WEBHOOK_SECRET=
CHAMABAPAY_PLATFORM_STORE_ID=

# Transactional email (Brevo SMTP: smtp-relay.brevo.com:587, STARTTLS + login)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=no-reply@chmaba.com
# Friendly sender name shown by mail clients (falls back to "no-reply" when unset).
MAIL_FROM_NAME=Chmaba POS
SMTP_USERNAME=<brevo smtp login>
SMTP_PASSWORD=<brevo smtp key>
SMTP_USE_TLS=true

# Host ports bound by the stack
HTTP_PORT=80
HTTPS_PORT=443

# Telegram platform notifications (internal "chmabagroup" ops chat).
# Create a bot with @BotFather, add it to the group, then read the chat id
# (e.g. from https://api.telegram.org/bot<token>/getUpdates). Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DIGEST_TIMEZONE=Asia/Phnom_Penh

# Platform self-monitoring (see docs/system-health.md). The API probes the
# database, KHQR checkout, outbound mail, media storage and the public hosts on
# a loop, and pages the Telegram chat above when one stays down. The defaults
# are usually right; the only value worth setting is the admin deep link used in
# alerts.
HEALTH_CHECK_WORKER_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=120
HEALTH_CHECK_ALERT_AFTER_FAILURES=2
HEALTH_CHECK_ALERT_COOLDOWN_MINUTES=30
PLATFORM_ADMIN_URL=https://admin.chmaba.com

# Hourly end-to-end payment test. In live mode the API mints a small test QR
# against its own internal ChmabaPay store, confirms it reads back, and posts
# the result to the Telegram chat above. The QR expires unused; nothing is
# charged. Mock mode records the test as skipped and posts nothing.
HEALTH_CHECK_PAYMENT_SMOKE_ENABLED=true
HEALTH_CHECK_PAYMENT_SMOKE_INTERVAL_SECONDS=3600
