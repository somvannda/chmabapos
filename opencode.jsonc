{
  "$schema": "https://opencode.ai/config.json",

  // Keep DeepSeek V4 Flash as the default for fast, cheap coding.
  // Change this only if your actual provider/model ID is different.
  "model": "deepseek/deepseek-v4-flash",

  // Automatically reduce old conversation context.
  // This helps prevent huge contexts from accumulating.
  // keep.tokens is the recent conversation preserved next to the summary;
  // it is the "token maximum" for how much detail survives a compaction.
  // Raise it so a feature in flight keeps its exact details.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 40000
    },
    "buffer": 20000
  },

  // Prevent noisy/generated folders from being watched.
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".pytest_cache/**",
      "build/**",
      ".next/**"
    ]
  },

  // Allow Build to run a full feature end to end instead of stopping to
  // summarize after a dozen steps. On the last step, tools are removed and the
  // model is asked to wrap up, so this is the ceiling for "long enough".
  // New user input resets the allowance.
  "agents": {
    "build": {
      "steps": 40
    }
  }
}