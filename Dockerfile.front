# Chmabapos front-end runtime: serves apps/web at / and apps/admin at /admin/*
# Multi-stage: builds both Vite apps, then serves them from nginx with SPA fallbacks.

# ---------- Build apps/web ----------
FROM node:20-alpine AS web-builder
WORKDIR /repo
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ .
RUN npm run build

# ---------- Build apps/admin ----------
FROM node:20-alpine AS admin-builder
WORKDIR /repo
COPY apps/admin/package.json ./
RUN npm install --no-audit --no-fund
COPY apps/admin/ .
RUN npm run build

# ---------- Serve ----------
FROM nginx:1.27-alpine
COPY --from=web-builder /repo/dist /usr/share/nginx/html/web
COPY --from=admin-builder /repo/dist /usr/share/nginx/html/admin
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
