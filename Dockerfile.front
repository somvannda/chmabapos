# Chmabapos front-end runtime: serves apps/web at / and apps/admin at /admin/*
# Multi-stage: builds both Vite apps, then serves them from nginx with SPA fallbacks.

# ---------- Build apps/web ----------
FROM node:20-alpine AS web-builder
WORKDIR /repo
# Preserve the real repo layout (`apps/web` with `packages/api-client` two
# levels up). Both apps depend on the shared client through the relative
# `file:../../packages/api-client` path, and npm's lockfile link resolution
# needs that depth. Flattening the app straight into `/repo` makes `npm ci`
# fail with a misleading "no package-lock.json" error.
COPY apps/web/package.json apps/web/package-lock.json ./apps/web/
COPY packages/api-client ./packages/api-client
RUN cd apps/web && npm ci
COPY apps/web/ ./apps/web/
RUN cd apps/web && npm run build

# ---------- Build apps/admin ----------
FROM node:20-alpine AS admin-builder
WORKDIR /repo
COPY apps/admin/package.json ./apps/admin/
COPY packages/api-client ./packages/api-client
RUN cd apps/admin && npm install --no-audit --no-fund
COPY apps/admin/ ./apps/admin/
RUN cd apps/admin && npm run build

# ---------- Serve ----------
FROM nginx:1.27-alpine
COPY --from=web-builder /repo/apps/web/dist /usr/share/nginx/html/web
COPY --from=admin-builder /repo/apps/admin/dist /usr/share/nginx/html/admin
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
