APP_NAME=Chmaba API
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/chmaba_v1
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/chmaba_v1
JWT_SECRET=replace-this-with-a-long-local-secret
JWT_ACCESS_TTL_MINUTES=60
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@chmaba.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAILHOG_UI_URL=http://localhost:8025
CUTLUY_MODE=mock
CUTLUY_API_URL=https://cutluy.com/v1
CUTLUY_API_KEY=
CUTLUY_WEBHOOK_SECRET=
PADDLE_MODE=mock
# sandbox -> https://sandbox-api.paddle.com, live -> https://api.paddle.com (override below)
PADDLE_API_URL=
PADDLE_API_KEY=
# Client-side token (checkout overlay) from Developer tools > Authentication
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# JSON map of Paddle price ids keyed by "<plan_code>:<billing_cycle>".
# - Prepaid one-time card checkout uses plain keys, e.g. "pro:annual".
# - Paddle auto-renew (recurring) uses "recurring:<plan>:<billing_cycle>" keys
#   pointing at a recurring (subscription) price id.
# Example:
# {"starter:monthly":"pri_01h...","recurring:pro:annual":"pri_01h..."}
PADDLE_PRICE_IDS={}
PADDLE_CHECKOUT_SUCCESS_URL=
PADDLE_CHECKOUT_FAILURE_URL=
