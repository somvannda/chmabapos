APP_NAME=Chmaba API
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/chmaba_v1
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/chmaba_v1
JWT_SECRET=replace-this-with-a-long-local-secret
JWT_ACCESS_TTL_MINUTES=60
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
# Cloudflare Turnstile bot protection on register/login (optional). When
# TURNSTILE_SECRET_KEY is blank the check is skipped, so local dev keeps working.
# The site key is also exposed to the web app as VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@chmaba.local
# Friendly sender name shown by mail clients (falls back to the address
# local-part, e.g. "no-reply", when unset).
MAIL_FROM_NAME=Chmaba POS
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAILHOG_UI_URL=http://localhost:8025
# ChmabaPay (https://pay.chmaba.com). There is no sandbox: CHAMABAPAY_MODE=mock
# is a local fake for development/tests; live moves real money.
CHAMABAPAY_MODE=mock
CHAMABAPAY_API_URL=https://pay.chmaba.com
CHAMABAPAY_API_KEY=
CHAMABAPAY_WEBHOOK_SECRET=
CHAMABAPAY_PLATFORM_STORE_ID=
# Paid plans stay usable this many hours past ends_at before the Free fallback.
BILLING_GRACE_HOURS=48
# Telegram platform notifications (internal "chmabagroup" ops chat). Both must be
# set to enable; when blank all sends are safe no-ops.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DIGEST_TIMEZONE=Asia/Phnom_Penh
# QZ Tray silent receipt printing (optional). Set both paths to enable the
# signing API; the private key never leaves the server. See docs/native-printing.md.
QZ_PRINT_CERTIFICATE_PATH=
QZ_PRINT_PRIVATE_KEY_PATH=
QZ_PRINT_SIGNATURE_ALGORITHM=SHA512
QZ_PRINT_REQUEST_MAX_BYTES=16384
QZ_PRINT_SIGN_RATE_LIMIT_PER_MINUTE=120
