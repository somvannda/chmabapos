# Dependency/build artifacts - never copied into images
**/node_modules
**/dist
# JVM heap dumps from crashed Gradle/Kotlin daemons. Four of these were sitting in
# apps/android at ~790 MB each, which bloated the build context past 500 MB and made
# `docker compose build front` die with an RPC EOF. They are crash artefacts, never
# inputs to a build.
**/*.hprof
**/*.hprof.gz
# Gradle's own caches and outputs.
**/.gradle
**/app/build

# SwiftPM build output. NOTE: this must be `**/.build`, not `**/build` -- the
# existing `**/build` pattern does NOT match a dot-prefixed directory. apps/ios
# .build contains SYMLINKS (.build/debug -> out/Products/Debug-iphoneos), which
# Windows cannot traverse, so Docker fails with "error from sender: open
# ...\.build\debug: The file cannot be accessed by the system" and the whole
# build context fails.
**/.build
**/.swiftpm

# xtool's built .app bundle (large, and regenerated on every build).
apps/ios/xtool
# The storefront's server-rendered output (apps/storefront/build). Regenerated
# inside the image, so a stale local copy must not be copied into the context.
**/build
**/.pytest_cache
**/__pycache__
**/*.py[cod]
**/.mypy_cache
**/.ruff_cache
**/.venv

# Secrets - must never be baked into an image
**/.env
**/.env.local

# Logs / runtime data
**/*.log
**/*.db
**/*.sqlite3

# VCS / tooling
.git
.github
docs
opencode.jsonc
tables.txt
